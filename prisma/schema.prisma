generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Changed from sqlite
  url      = env("DATABASE_URL")
}

model User {
  id                    String           @id @unique
  email                 String           @unique
  name                  String?
  transactions          Transaction[]
  debts                 Debt[]
  assetItems            AssetItem[]
  otherLiabilityItems   OtherLiabilityItem[]
  budgetItems           BudgetItem[]
  statementSettings     StatementSettings?
  notifications         Notification[]
  ownedWeeklyReviews    WeeklyReview[]   @relation("OwnedReviews")
  sharedReviewsCreated  SharedReview[]   @relation("ReviewsSharedByOwner")
  reviewsSharedWithMe   SharedReview[]   @relation("ReviewsSharedWithUser")
  investmentItems       InvestmentItem[] // Added relation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id                String                  @id @default(cuid())
  userId            String
  date              DateTime
  description       String
  amount            Float
  modeOfPayment     String // "Cash", "Bank", "Mpesa"
  frequency         String? // "recurring", "one-time"
  variability       String? // "fixed", "variable"
  categoryName      String? // Link to BudgetItem's description
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([userId, date])
}

model Debt {
  id            String   @id @default(cuid())
  userId        String
  description   String
  principal     Float
  interestRate  Float // Annual percentage rate
  minPayment    Float
  term          String // "short", "long"
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model AssetItem {
  id          String   @id @default(cuid())
  userId      String
  description String
  amount      Float
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model OtherLiabilityItem {
  id          String   @id @default(cuid())
  userId      String
  description String
  amount      Float
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model BudgetItem {
  id          String   @id @default(cuid())
  userId      String
  description String
  amount      Float
  category    String // "income", "recurring-expense", "one-time-expense", "goal", "debt"
  period      String // Format: "YYYY-MM" e.g., "2024-07"
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, period])
}

model InvestmentItem {
  id            String   @id @default(cuid())
  userId        String
  name          String
  type          String // e.g., Stock, Bond, Real Estate
  purchaseDate  DateTime
  quantity      Float
  purchasePrice Float
  currentValue  Float
  currency      String   @default("KES")
  notes         String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model StatementSettings {
  userId                 String    @id @unique
  statementStartDate     DateTime?
  statementEndDate       DateTime?
  gettingStartedDismissed Boolean   @default(false)
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model WeeklyReview {
  id                  String          @id @default(cuid())
  userId              String // Owner of the review
  weekKey             String // Format: "YYYY-WW", e.g., "2024-28"
  journal             String?
  transactionComments Json? // Reverted to Json? for PostgreSQL
  user                User            @relation("OwnedReviews", fields: [userId], references: [id], onDelete: Cascade)
  sharedInstances     SharedReview[]  @relation("OriginalReview")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([userId, weekKey]) // Ensure a user can only have one review per weekKey
  @@index([userId])
}

model SharedReview {
  id              String        @id @default(cuid())
  weekKey         String
  reviewOwnerId   String
  sharedWithId    String
  originalReview  WeeklyReview  @relation("OriginalReview", fields: [reviewOwnerId, weekKey], references: [userId, weekKey], onDelete: Cascade)
  owner           User          @relation("ReviewsSharedByOwner", fields: [reviewOwnerId], references: [id], onDelete: Cascade)
  sharedWithUser  User          @relation("ReviewsSharedWithUser", fields: [sharedWithId], references: [id], onDelete: Cascade)
  sharedAt        DateTime      @default(now())

  @@unique([reviewOwnerId, weekKey, sharedWithId]) // Prevent duplicate shares
  @@index([sharedWithId]) // For quick lookup of reviews shared with a user
  @@index([reviewOwnerId, weekKey]) // For finding all shares of a specific review
}


model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // "info", "warning", "error", "success", "budget", "collaboration", "update"
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, timestamp])
}
