rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Core helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'seanwambua@gmail.com' ||
          request.auth.token.email.lower() == 'rashmore2020@gmail.com'
        )) ||
        request.auth.uid == 'admin-seanwambua-uid'
      );
    }

    function isAuditor() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/auditors/$(request.auth.uid)) ||
        isAdmin()
      );
    }

    // User profile documents & their subcollections
    match /users/{userId} {
      // Read access allowed for owner, admin, or auditor
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin() || isAuditor());
      // Users can create/update their profile, admin can manage all
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();

      // User personal financial data collections (transactions, debts, assets, liabilities, budget, reviews, settings, notifications)
      match /{allSubcollections=**} {
        // Auditors and Admins can review client data in read-only mode; Owner has full read/write
        allow read: if isSignedIn() && (
          isOwner(userId) || 
          isAdmin() || 
          isAuditor() ||
          userId == 'admin-seanwambua-uid' || 
          userId == 'demo-user-alex-uid'
        );
        // Only owner or admin can write; auditors are strictly forbidden from modifying financial data
        allow write: if isSignedIn() && (
          isOwner(userId) || 
          isAdmin() || 
          userId == 'admin-seanwambua-uid' || 
          userId == 'demo-user-alex-uid'
        );
      }
    }

    // Shared reviews for peer accountability and period review discussions
    match /sharedReviews/{shareId} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.ownerUserId == request.auth.uid ||
        resource.data.sharedWithId == request.auth.uid ||
        resource.data.sharedWithUserId == request.auth.uid ||
        isAdmin() ||
        isAuditor() ||
        request.auth.uid == 'admin-seanwambua-uid' ||
        request.auth.uid == 'demo-user-alex-uid'
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.ownerUserId == request.auth.uid ||
        isAdmin()
      );

      // Realtime discussion comments subcollection
      match /chats/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    // System Administrator registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Compliance & Financial Auditor registry
    match /auditors/{auditorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Operational, security, and pay-per-use audit logs
    match /auditLogs/{logId} {
      allow read: if isAdmin() || isAuditor() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Official Auditor Period Verifications and Sign-Offs
    match /auditVerifications/{verificationId} {
      allow read: if isAdmin() || isAuditor() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow create, update: if isAdmin() || isAuditor();
      allow delete: if isAdmin();
    }

    // Global application configuration (e.g., pricingRateCard)
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Fallback closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
